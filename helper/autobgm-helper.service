[Unit]
Description=Auto BGM Linux media playback bridge
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# env searches the user service's PATH for the installed executable.
ExecStart=env autobgm-helper
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=graphical-session.target
